{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golden-tavern",
  "main": "worker.py",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {}
}
